{
  "name": "social-media",
  "version": "0.1.0",
  "private": true,
  "description": "SoCalMedic multi-app video platform — clone to D:\\social-media",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@social-media/api",
    "dev:admin": "npm run dev --workspace=@social-media/admin",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@social-media/database",
    "db:migrate": "npm run migrate --workspace=@social-media/database",
    "db:push": "npm run push --workspace=@social-media/database",
    "db:seed": "npm run seed --workspace=@social-media/database",
    "db:studio": "npm run studio --workspace=@social-media/database"
  },
  "engines": {
    "node": ">=20"
  }
}
