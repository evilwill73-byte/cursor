# Copy to .env in project root (D:\social-media\.env)

DATABASE_URL="postgresql://socalmedic:socalmedic@localhost:5432/socalmedic?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
ADMIN_JWT_SECRET="change-me-admin-secret"
ADMIN_JWT_EXPIRES_IN="8h"

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="socalmedic-videos"
R2_PUBLIC_URL="https://cdn.yourdomain.com"

API_PORT=3000
ADMIN_PORT=3001
NODE_ENV=development

# Seed defaults (change in production)
SEED_SUPER_ADMIN_EMAIL="admin@platform.local"
SEED_SUPER_ADMIN_PASSWORD="Admin123!"
SEED_APP_SLUG="socalmedic"
SEED_APP_NAME="SoCalMedic"
